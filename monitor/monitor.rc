// monitor.rc - Recursos do programa Monitor
#include <windows.h>

#define IDD_DIALOG1     101
#define IDC_EDIT1       1001
#define IDC_EDIT2       1002
#define IDC_EDIT3       1003
#define IDC_EDIT4       1004

LANGUAGE 0x16, 0x01
#pragma code_page(1252)

IDD_DIALOG1 DIALOGEX 0, 0, 320, 220
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "⚙️ Configuração do Monitor"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Visualização", -1, 10, 5, 300, 45
    LTEXT           "Máximo de alertas por página:", -1, 20, 18, 150, 10
    EDITTEXT        IDC_EDIT1, 200, 16, 50, 14, ES_NUMBER

    GROUPBOX        "Nomes de Recursos (Avançado)", -1, 10, 55, 300, 125
    LTEXT           "Nome do SHM:", -1, 20, 70, 150, 10
    EDITTEXT        IDC_EDIT2, 20, 82, 280, 14
    
    LTEXT           "Nome do Evento:", -1, 20, 100, 150, 10
    EDITTEXT        IDC_EDIT3, 20, 112, 280, 14
    
    LTEXT           "Nome do Mutex:", -1, 20, 130, 150, 10
    EDITTEXT        IDC_EDIT4, 20, 142, 280, 14

    LTEXT           "💡 Deixar em branco para usar valores predefinidos", -1, 20, 160, 280, 10, WS_DISABLED

    DEFPUSHBUTTON   "✓ OK", IDOK, 80, 190, 70, 18
    PUSHBUTTON      "✕ Cancelar", IDCANCEL, 170, 190, 70, 18
END