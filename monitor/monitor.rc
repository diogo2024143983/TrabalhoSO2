// monitor.rc - Recursos do programa Monitor
#include <windows.h>

#define IDD_DIALOG1     101
#define IDC_EDIT1       1001
#define IDC_EDIT2       1002
#define IDC_EDIT3       1003
#define IDC_EDIT4       1004

LANGUAGE 0x16, 0x01
#pragma code_page(1252)

IDD_DIALOG1 DIALOGEX 0, 0, 280, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuracao"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "Numero maximo de alertas:", -1, 10, 10, 120, 10
    EDITTEXT        IDC_EDIT1, 140, 8, 50, 14, ES_NUMBER
    LTEXT           "Nome SHM:", -1, 10, 35, 120, 10
    EDITTEXT        IDC_EDIT2, 140, 33, 130, 14
    LTEXT           "Nome Evento:", -1, 10, 60, 120, 10
    EDITTEXT        IDC_EDIT3, 140, 58, 130, 14
    LTEXT           "Nome Mutex:", -1, 10, 85, 120, 10
    EDITTEXT        IDC_EDIT4, 140, 83, 130, 14
    DEFPUSHBUTTON   "OK", IDOK, 60, 120, 60, 15
    PUSHBUTTON      "Cancelar", IDCANCEL, 140, 120, 60, 15
END